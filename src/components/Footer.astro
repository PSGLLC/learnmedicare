---
import { COMPLIANCE, TAGLINE, BOOKING_URL, NAV_LINKS, MEDICARE_QA_URL, PSG_INFO_LINKS } from '../site.config';
const year = 2026;

interface Props {
  showResetProgress?: boolean;
}
const { showResetProgress = false } = Astro.props;
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-columns">
      <div class="footer-col">
        <img src="/brand/psg-logo-nav.png" alt="Price Services Group logo" width="200" height="101" loading="lazy" decoding="async" />
        <h3>About LearnMedicare</h3>
        <p class="tagline">{TAGLINE}</p>
        <p>Free, unbiased Medicare education to help you understand your options with confidence.</p>
      </div>
      <div class="footer-col">
        <h3>Quick Links</h3>
        <nav class="footer-links">
          {NAV_LINKS.filter((l) => l.href !== '/').map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
          <a href={MEDICARE_QA_URL} target="_blank" rel="noopener noreferrer">Free Medicare Q&amp;A Tool</a>
        </nav>
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-teal">Schedule Free Review</a>
      </div>
      <div class="footer-col">
        <h3>PSG Info</h3>
        <p>Presented by Price Services Group, LLC</p>
        <p>Licensed Insurance Agent</p>
        <p>{COMPLIANCE.npn} &bull; {COMPLIANCE.agencyNpn}</p>
        <p><a href="mailto:hello@priceservicesgroup.com">hello@priceservicesgroup.com</a></p>
        <p>Licensed in: {COMPLIANCE.states.join(', ')}</p>
        <nav class="footer-links footer-psg-info">
          {PSG_INFO_LINKS.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <div class="compliance">
      <p class="tpmo">{COMPLIANCE.tpmo}</p>
      <p class="legal-links">
        <a href="/privacy">Privacy Policy</a> &bull; <a href="/terms">Terms of Use</a> &bull; <a href="/agent-resources">Agent Resources</a>
        {showResetProgress && (
          <>
            &bull; <button type="button" id="reset-progress-link" class="reset-progress-link">Reset Progress</button>
          </>
        )}
      </p>
      <p class="copyright">&copy; {year} Price Services Group LLC. {TAGLINE} &bull; Not affiliated with Medicare.gov or CMS.</p>
    </div>

    <div class="tpmo-disclaimer">
      <p>We do not offer every plan available in your area. Please contact Medicare.gov, 1-800-MEDICARE, or your local State Health Insurance Program (SHIP) to get information on all of your options.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--text-primary);
    color: #e7dcf4;
    padding: 3.5rem 0 2rem;
    margin-top: 3rem;
    border-top: 4px solid var(--fill-teal);
  }
  .footer-inner { display: flex; flex-direction: column; gap: 2rem; }
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .footer-col h3 {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 1.05rem;
    margin: 0.75rem 0 0.75rem;
  }
  .footer-col p { font-size: 0.85rem; color: #d8c8ea; margin: 0 0 0.4rem; }
  .footer-col a { color: #d8c8ea; }
  .footer-col a:hover { color: var(--fill-teal); }
  .footer-col img { height: 34px; }
  .tagline { font-family: var(--font-heading); font-style: italic; color: var(--fill-teal) !important; }
  .footer-links { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
  .footer-links a { color: #d8c8ea; text-decoration: none; font-size: 0.9rem; }
  .footer-links a:hover { color: var(--fill-teal); }
  .compliance p {
    font-size: 0.78rem;
    line-height: 1.6;
    color: #b6a4cb;
    max-width: 900px;
    margin: 0 0 0.5rem;
  }
  @media (max-width: 900px) {
    .footer-columns { grid-template-columns: 1fr; }
  }
  .copyright { color: #9e8bb6; }
  .legal-links { }
  .legal-links a { color: #b6a4cb; text-decoration: underline; }
  .legal-links a:hover { color: var(--fill-teal); }
  .tpmo-disclaimer {
    max-width: 900px;
    margin: 0.5rem auto 0;
    text-align: center;
  }
  .tpmo-disclaimer p {
    font-family: 'Open Sans', sans-serif;
    font-size: 12px;
    color: #b6a4cb;
    margin: 0;
  }
  .reset-progress-link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: #b6a4cb;
    text-decoration: underline;
    cursor: pointer;
  }
  .reset-progress-link:hover {
    color: var(--fill-teal);
  }
</style>

{showResetProgress && (
  <script>
    import { resetProgress } from '../scripts/course-progress';

    document.getElementById('reset-progress-link')?.addEventListener('click', () => {
      if (window.confirm('Reset your course progress? This clears completed/started status for all lessons on this device.')) {
        resetProgress();
        window.location.reload();
      }
    });
  </script>
)}
