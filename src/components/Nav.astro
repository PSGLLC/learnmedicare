---
import { NAV_LINKS, RESOURCES_DROPDOWN, BOOKING_URL, MEDICARE_QA_URL } from '../site.config';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isResourcesActive = RESOURCES_DROPDOWN.some((l) => current === l.href.replace(/\/$/, ''));
---
<header class="nav-wrap">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <img src="/brand/psg-logo-nav.png" alt="Price Services Group logo" width="200" height="101" fetchpriority="high" decoding="async" />
      <span class="brand-name"><span class="brand-learn">Learn</span><span class="brand-medicare">Medicare</span></span>
    </a>
    <div class="nav-right">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="nav-links" id="nav-links">
      {NAV_LINKS.map((link) => {
        const isActive = current === link.href.replace(/\/$/, '') || (link.href === '/' && current === '/');
        if (link.href === '/blog') {
          return (
            <>
              <a href={MEDICARE_QA_URL} target="_blank" rel="noopener noreferrer" class="nav-link">Medicare Q&amp;A</a>
              <a href={link.href} class:list={['nav-link', { active: isActive }]}>{link.label}</a>
            </>
          );
        }
        return (
          <a href={link.href} class:list={['nav-link', { active: isActive }]}>{link.label}</a>
        );
      })}
      <div class="nav-dropdown">
        <button
          type="button"
          class:list={['nav-link', 'nav-dropdown-toggle', { active: isResourcesActive }]}
          id="resources-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Resources <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
        </button>
        <div class="nav-dropdown-menu" id="resources-menu" aria-labelledby="resources-toggle">
          {RESOURCES_DROPDOWN.map((link) => {
            const isActive = current === link.href.replace(/\/$/, '');
            return (
              <a href={link.href} class:list={['nav-dropdown-link', { active: isActive }]}>{link.label}</a>
            );
          })}
        </div>
      </div>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-cta">Schedule Free Review</a>
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    border-bottom: 2px solid var(--fill-teal);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-primary);
  }
  .brand img { height: 40px; width: auto; display: block; }
  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .brand-learn { color: var(--fill-accent); }
  .brand-medicare { color: var(--fill-teal); }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--fill-accent); border-color: var(--fill-accent); }
  .icon-moon { display: none; }
  :root[data-theme="dark"] .icon-sun { display: none; }
  :root[data-theme="dark"] .icon-moon { display: block; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav-link:hover, .nav-link.active { color: var(--fill-accent); }
  :root[data-theme="dark"] .nav-link:hover,
  :root[data-theme="dark"] .nav-link.active { color: var(--fill-teal); }
  .nav-cta { padding: 0.55rem 1.25rem; font-size: 0.9rem; }

  .nav-dropdown { position: relative; }
  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    padding: 0;
  }
  .nav-dropdown-caret { font-size: 0.7rem; }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    padding: 0.5rem;
    min-width: 220px;
    z-index: 10;
  }
  .nav-dropdown-menu.open { display: block; }
  .nav-dropdown-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .nav-dropdown-link:hover, .nav-dropdown-link.active {
    background: var(--fill-purple-light);
    color: var(--fill-accent);
  }
  :root[data-theme="dark"] .nav-dropdown-link:hover,
  :root[data-theme="dark"] .nav-dropdown-link.active {
    background: rgba(144, 89, 181, 0.15);
    color: var(--fill-teal);
  }
  @media (max-width: 980px) {
    .nav-dropdown-menu {
      display: block;
      position: static;
      box-shadow: none;
      border: none;
      background: none;
      padding: 0 0 0 1rem;
      min-width: 0;
    }
    .nav-dropdown-menu.open { display: block; }
    .nav-dropdown-toggle { width: 100%; justify-content: space-between; }
  }
  .nav-toggle { display: none; background: none; border: none; cursor: pointer; }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    margin: 5px 0;
    background: var(--text-primary);
  }
  @media (max-width: 980px) {
    .nav-toggle { display: block; }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.5rem 1.5rem;
      gap: 1rem;
    }
    .nav-links.open { display: flex; }
    .nav-cta { width: 100%; text-align: center; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });

  const resourcesToggle = document.getElementById('resources-toggle');
  const resourcesMenu = document.getElementById('resources-menu');
  resourcesToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = resourcesMenu?.classList.toggle('open');
    resourcesToggle.setAttribute('aria-expanded', String(!!isOpen));
  });
  document.addEventListener('click', (e) => {
    if (resourcesMenu?.classList.contains('open') && !resourcesMenu.contains(e.target as Node) && e.target !== resourcesToggle) {
      resourcesMenu.classList.remove('open');
      resourcesToggle?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      resourcesMenu?.classList.remove('open');
      resourcesToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
