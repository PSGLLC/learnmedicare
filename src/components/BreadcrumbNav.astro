---
// Visible breadcrumb trail. BaseLayout/MinimalLayout already emit the
// BreadcrumbList JSON-LD from the same `breadcrumbs` prop passed to them —
// this component is the visible counterpart, so pass the same array to
// both. "Home" is prepended automatically, matching the layouts' schema.
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const trail = [{ name: 'Home', url: '/' }, ...crumbs];
---
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      {trail.map((crumb, i) => (
        <li>
          {i === trail.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.url}>{crumb.name}</a>
          )}
          {i < trail.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .breadcrumb-nav { padding: 0.85rem 0; }
  .breadcrumb-nav ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0; padding: 0; font-size: 0.85rem; }
  .breadcrumb-nav li { display: flex; align-items: center; gap: 0.35rem; }
  .breadcrumb-nav a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb-nav a:hover { color: var(--color-purple); text-decoration: underline; }
  .breadcrumb-nav span[aria-current] { color: var(--color-text); font-weight: 600; }
  .breadcrumb-nav .sep { color: var(--color-border); }
</style>
