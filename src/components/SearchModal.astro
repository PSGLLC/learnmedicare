---
// Site search — Pagefind's default UI, lazy-loaded only when opened so the
// WASM runtime never ships in the main bundle. Indexed at build time via
// `pagefind --site dist` (see package.json "build" script); the index lives
// at /pagefind/ and doesn't exist in `astro dev`, so this is a no-op locally
// until you run a production build.
//
// Inline-expanding panel, not a full-screen modal (redesigned from the
// original full-viewport overlay — see git history for why: `.search-panel`
// setting `display` unconditionally meant the `hidden` attribute never
// actually hid it, since an author-stylesheet class rule at equal
// specificity beats the UA stylesheet's `[hidden]{display:none}`. Fixed
// here via the explicit `.search-panel[hidden]{display:none}` override
// below — same fix already applied once before in this repo, see
// course.astro's `.vl-videos[hidden]` comment for the identical bug.
---
<div class="search-wrap">
  <button
    id="search-toggle"
    type="button"
    class="search-toggle-btn"
    aria-label="Search"
    aria-haspopup="dialog"
    aria-controls="search-panel"
    aria-expanded="false"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
  </button>

  <div id="search-panel" class="search-panel" role="dialog" aria-label="Search this site" hidden>
    <div id="pagefind-search"></div>
  </div>
</div>

<script is:inline>
  (function () {
    var wrap = document.querySelector(".search-wrap");
    var toggle = document.getElementById("search-toggle");
    var panel = document.getElementById("search-panel");
    if (!wrap || !toggle || !panel) return;

    var pagefindLoaded = false;

    function loadPagefindUI() {
      if (pagefindLoaded) return;
      pagefindLoaded = true;

      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(link);

      var script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = function () {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: "#pagefind-search", showSubResults: true, showImages: false });
        }
        var input = panel.querySelector("input");
        if (input) input.focus();
      };
      document.body.appendChild(script);
    }

    function openPanel() {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      loadPagefindUI();
      var input = panel.querySelector("input");
      if (input) input.focus();
    }

    function closePanel(refocusToggle) {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      if (refocusToggle) toggle.focus();
    }

    toggle.addEventListener("click", function () {
      if (panel.hidden) openPanel();
      else closePanel(false);
    });

    // Click outside the panel (and not on the toggle itself) closes it —
    // there's no backdrop element anymore to attach this to, since the
    // panel no longer blocks the rest of the page.
    document.addEventListener("click", function (e) {
      if (panel.hidden) return;
      if (wrap.contains(e.target)) return;
      closePanel(false);
    });

    document.addEventListener("keydown", function (e) {
      var isTyping = document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "TEXTAREA";
      if (panel.hidden && ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !isTyping))) {
        e.preventDefault();
        openPanel();
      }
      if (e.key === "Escape" && !panel.hidden) {
        closePanel(true);
      }
    });
  })();
</script>

<style>
  .search-wrap { position: relative; }

  .search-toggle-btn{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:999px;border:1px solid var(--border);background:transparent;color:var(--text-secondary);cursor:pointer}
  .search-toggle-btn:hover{color:var(--fill-accent);border-color:var(--fill-accent)}
  :root[data-theme="dark"] .search-toggle-btn:hover{color:var(--fill-teal);border-color:var(--fill-teal)}

  .search-panel{
    position:absolute;top:calc(100% + 0.6rem);right:0;z-index:100;
    width:min(380px,90vw);max-height:min(70vh,480px);overflow:auto;
    background:var(--bg-primary,#fff);border:1px solid var(--border);border-radius:12px;
    box-shadow:0 12px 32px rgba(0,0,0,.18);padding:.6rem;
  }
  /* The fix: an explicit override for the hidden attribute. Without this,
     the position/z-index/etc. rule above (an author-stylesheet class
     selector) wins over the UA stylesheet's `[hidden]{display:none}` at
     equal specificity, and the panel renders open regardless of the
     `hidden` attribute/property. */
  .search-panel[hidden]{display:none}

  @media(max-width:640px){
    .search-panel{position:fixed;top:64px;left:.75rem;right:.75rem;width:auto}
  }
</style>
