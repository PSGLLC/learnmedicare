---
// Standardizes the `.page-hero` pattern (eyebrow / h1 / subtext / optional
// CTA) used across lesson-style pages. Slot content (e.g. AuthorByline)
// can be dropped in below the subtext.
interface Cta {
  text: string;
  url: string;
  external?: boolean;
}
interface Props {
  label: string;
  heading: string;
  subtext?: string;
  cta?: Cta;
}
const { label, heading, subtext, cta } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{label}</p>
    <h1>{heading}</h1>
    {subtext && <p class="subhead">{subtext}</p>}
    <slot />
    {cta && (
      cta.external ? (
        <a href={cta.url} target="_blank" rel="noopener noreferrer" class="btn btn-teal" style="margin-top:1.5rem;">{cta.text}</a>
      ) : (
        <a href={cta.url} class="btn btn-teal" style="margin-top:1.5rem;">{cta.text}</a>
      )
    )}
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--fill-accent) 0%, #6d3f8f 100%);
    padding: 4rem 0;
  }
  .page-hero .eyebrow { color: var(--fill-teal); }
  .page-hero h1 { color: #fff; }
  .subhead { color: #f0e6f8; font-size: 1.1rem; max-width: 680px; }
</style>
