---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AuthorByline from '../components/AuthorByline.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQSection from '../components/FAQSection.astro';
import { authorship } from '../lib/schema';

const DATE_PUBLISHED = '2026-07-23';
const DATE_MODIFIED = '2026-11-23';

const faqs = [
  { question: 'What is Medicare?', answer: 'Medicare is the federal health insurance program run by the Centers for Medicare & Medicaid Services (CMS). It primarily covers people age 65 and older, as well as certain younger people with qualifying disabilities or End-Stage Renal Disease (ESRD).' },
  { question: 'Who is eligible for Medicare?', answer: "Most people become eligible at age 65 if they or a spouse have at least 10 years (40 quarters) of Medicare-covered employment. People under 65 may also qualify due to certain disabilities or a diagnosis of ESRD or ALS." },
  { question: 'When can I enroll in Medicare?', answer: 'Your Initial Enrollment Period runs 7 months — the 3 months before your 65th birthday month, your birthday month, and the 3 months after. Outside of that, there are also the Annual Enrollment Period (Oct 15–Dec 7), the Medicare Advantage Open Enrollment Period (Jan 1–Mar 31), and Special Enrollment Periods tied to certain life events.' },
  { question: 'What is the difference between Medicare Advantage and Original Medicare?', answer: "Original Medicare (Parts A and B) is run directly by the federal government and lets you see any provider nationwide who accepts Medicare. Medicare Advantage (Part C) is an alternative way to get your Part A and B benefits through a private insurer, often bundling in Part D and extra benefits, but typically within a provider network." },
  { question: 'What does Medicare Part A cover?', answer: 'Part A generally covers inpatient hospital stays, care in a skilled nursing facility, hospice care, and some home health care. Most people don’t pay a monthly premium for Part A because of their work history.' },
  { question: 'What does Medicare Part B cover?', answer: 'Part B generally covers doctor visits, outpatient care, preventive services like screenings and vaccines, and durable medical equipment. Nearly everyone pays a monthly premium for Part B.' },
  { question: 'What does Medicare Part D cover?', answer: "Part D covers prescription medications. It's offered through private insurance companies, either as a stand-alone plan alongside Original Medicare or bundled into a Medicare Advantage plan. Going without creditable drug coverage can lead to a lasting late enrollment penalty." },
  { question: 'What is a Medigap plan?', answer: 'A Medigap (Medicare Supplement) plan is private insurance that works alongside Original Medicare to help cover costs like copays, coinsurance, and deductibles that Medicare doesn’t pay. Medigap plans don’t work with Medicare Advantage and typically don’t include drug coverage.' },
  { question: 'How much does Medicare cost?', answer: 'Costs vary by part and by plan. Part A is usually premium-free if you have enough work history. Part B has a standard monthly premium plus an annual deductible. Part C and Part D premiums vary by plan and location since they’re sold through private insurers. Exact figures change every year, so it’s worth checking current numbers at Medicare.gov.' },
  { question: 'What is the Medicare Initial Enrollment Period?', answer: 'The Initial Enrollment Period (IEP) is the 7-month window centered on your 65th birthday — 3 months before, your birthday month, and 3 months after — during which you can first enroll in Medicare without a late enrollment penalty.' },
  { question: 'Can I keep my doctor with Medicare Advantage?', answer: 'It depends on the plan. Medicare Advantage plans typically use HMO or PPO provider networks, so you’ll want to confirm your doctor is in-network before enrolling. Original Medicare, by contrast, lets you see any doctor nationwide who accepts Medicare.' },
  { question: 'What happens if I miss my enrollment window?', answer: 'Missing your enrollment window can mean waiting for the next available period (like the Annual Enrollment Period) and may result in a late enrollment penalty for Part B or Part D that can last as long as you have that coverage.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Medicare FAQ',
    description: 'Get answers to the most common Medicare questions — eligibility, enrollment, costs, plan types, and more.',
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
];
---
<BaseLayout
  title="Medicare FAQ — Common Questions Answered | LearnMedicare.org"
  description="Get answers to the most common Medicare questions on eligibility, enrollment, costs, and plan types — plain-English explanations, no sales pitch."
  path="/faq/"
  breadcrumbs={[{ name: 'FAQ', url: '/faq/' }]}
  jsonLd={jsonLd}
>
  <BreadcrumbNav crumbs={[{ name: 'FAQ', url: '/faq/' }]} />
  <PageHero label="FAQ" heading="Medicare FAQ" subtext="Answers to the questions we hear most often.">
    <AuthorByline date={DATE_MODIFIED} datePublished={DATE_PUBLISHED} />
  </PageHero>

  <FAQSection faqs={faqs} heading="" />

  <section class="section-alt lead-section">
    <div class="container lead-inner">
      <p class="eyebrow">Free Medicare guide</p>
      <h2>Read the Medicare at 65 guide</h2>
      <p class="lead-sub">Email delivery may be unavailable. You can read the source-linked guide or download the printable PDF now without submitting this form.</p>
      <div class="guide-actions">
        <a class="btn btn-primary" href="/medicare-at-65-guide/">Read the guide online</a>
        <a class="btn btn-outline" href="/docs/T65-Medicare-Guide.pdf">Download the printable guide (PDF)</a>
      </div>

      <div class="request-panel">
        <h3>Email me the guide</h3>
        <p class="request-disclosure">We’ll use your email only to process this one-time guide request. This does not sign you up for ongoing marketing, calls, or texts. Email delivery may not be available for every request; the guide and PDF links above remain available either way. See our <a href="/privacy/">Privacy Policy</a>.</p>
        <form id="faq-guide-request-form" class="lead-form" novalidate>
          <div class="form-row">
            <label for="faq-email">Email address</label>
            <input id="faq-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="hp-field" aria-hidden="true">
            <label for="faq-website">Leave this field blank</label>
            <input id="faq-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="btn btn-primary form-submit">Email me the guide</button>
          <p id="faq-guide-error" class="form-error" role="alert" tabindex="-1" hidden></p>
          <p id="faq-guide-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
          <button id="faq-guide-another" class="btn btn-outline another-request" type="button" hidden>Request another copy</button>
        </form>
      </div>
    </div>
  </section>

<script>
  const form = document.getElementById('faq-guide-request-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('faq-guide-error');
  const statusEl = document.getElementById('faq-guide-status');
  const anotherButton = document.getElementById('faq-guide-another') as HTMLButtonElement | null;
  let requestId = crypto.randomUUID();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
    if (statusEl) { statusEl.hidden = true; statusEl.textContent = ''; }
    if (anotherButton) anotherButton.hidden = true;

    const formData = new FormData(form);
    const submitButton = form.querySelector<HTMLButtonElement>('.form-submit');
    if (submitButton) { submitButton.disabled = true; submitButton.textContent = 'Sending request…'; }

    const showError = (message: string) => {
      if (errorEl) { errorEl.textContent = message; errorEl.hidden = false; errorEl.focus(); }
    };
    try {
      const response = await fetch('/api/faq-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: String(formData.get('email') ?? '').trim(),
          website: String(formData.get('website') ?? ''),
          requestId,
        }),
      });
      const data = await response.json().catch(() => ({ status: 'unavailable' }));
      if (data.status === 'queued') {
        if (statusEl) {
          statusEl.textContent = 'Your request was accepted for processing. This page cannot confirm email delivery. Check your inbox and spam folder; the guide and PDF links above are available now.';
          statusEl.hidden = false;
          statusEl.focus();
        }
        if (anotherButton) anotherButton.hidden = false;
        return;
      }
      if (data.status === 'email_unavailable' || data.status === 'recipient_needs_help' || data.status === 'unavailable' || data.status === 'rate_limited') {
        showError('Email delivery could not be completed for this request. The guide and PDF links above are available now, or contact us for help.');
        return;
      }
      if (data.status === 'delivery_unconfirmed' || data.status === 'already_processing') {
        showError('We could not confirm the outcome of this request. Please do not submit it again yet. The guide and PDF links above are available now, or contact us for help.');
        return;
      }
      if (response.status === 400) {
        showError('Enter a valid email address.');
        return;
      }
      showError('Email delivery could not be completed for this request. The guide and PDF links above are available now, or contact us for help.');
    } catch {
      showError('We could not confirm the outcome of this request. Please do not submit it again yet. The guide and PDF links above are available now, or contact us for help.');
    } finally {
      if (submitButton) { submitButton.disabled = false; submitButton.textContent = 'Email me the guide'; }
    }
  });

  anotherButton?.addEventListener('click', () => {
    requestId = crypto.randomUUID();
    form?.reset();
    if (statusEl) { statusEl.hidden = true; statusEl.textContent = ''; }
    if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
    if (anotherButton) anotherButton.hidden = true;
    form?.querySelector<HTMLInputElement>('#faq-email')?.focus();
  });
</script>
</BaseLayout>

<style>
  .lead-section { padding: 4rem 0; }
  .lead-inner { max-width: 520px; margin: 0 auto; text-align: center; }
  .lead-sub { color: var(--text-secondary); margin-bottom: 1.75rem; }
  .guide-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .guide-actions a { max-width: 100%; text-align: center; }
  .request-panel { max-width: 520px; margin: 3rem auto 0; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-primary); text-align: left; }
  .request-panel h3 { text-align: center; margin-top: 0; }
  .request-disclosure { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.6; }
  .lead-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-row { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-row label { color: var(--text-primary); font-weight: 600; }
  .form-row input { width: 100%; min-width: 0; padding: 0.7rem 0.9rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-primary); color: var(--text-primary); font: inherit; }
  .form-row input:focus-visible, .form-submit:focus-visible, .another-request:focus-visible { outline: 3px solid var(--fill-accent); outline-offset: 2px; }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form-submit { width: 100%; }
  .form-submit:disabled { opacity: 0.7; cursor: wait; }
  .form-error { margin: 0; color: #a32020; font-weight: 600; }
  .form-status { margin: 0; padding: 1rem; border-radius: var(--radius); background: var(--fill-purple-light); color: var(--text-primary); }
  .another-request { width: 100%; }
  @media (max-width: 560px) { .request-panel { padding: 1rem; } .guide-actions { flex-direction: column; } }

</style>
