---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AuthorByline from '../components/AuthorByline.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQSection from '../components/FAQSection.astro';
import { authorship, dataset } from '../lib/schema';
import { BOOKING_URL } from '../site.config';

const DATE_PUBLISHED = '2026-07-28';
const DATE_MODIFIED = '2026-07-28';

const faqs = [
  { question: 'When does my Medicare Initial Enrollment Period start?', answer: 'Your Initial Enrollment Period is 7 months long: it starts 3 months before the month you turn 65, includes your birthday month, and ends 3 months after.' },
  { question: 'Do I have to sign up for Medicare at 65 if I\'m still working?', answer: 'Not always. If you have qualifying coverage through a current employer (usually one with 20 or more employees), you may be able to delay Part B without a penalty. If your coverage is through a smaller employer or retiree plan, the rules differ, so it\'s worth checking your specific situation before your window closes.' },
  { question: 'What\'s the difference between Part A and Part B?', answer: 'Part A covers hospital stays, skilled nursing facility care, and hospice. Part B covers doctor visits, outpatient care, and preventive services. Most people get Part A premium-free but pay a monthly premium for Part B.' },
  { question: 'What happens if I miss my Initial Enrollment Period?', answer: 'If you don\'t have other qualifying coverage and miss your window, you may face a late enrollment penalty added to your Part B premium for as long as you have Medicare, plus a gap in coverage until the next enrollment period opens.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Turning 65? Here\'s What You Need to Know About Medicare',
    description: 'A clear, no-jargon guide to your Medicare Initial Enrollment Period, the decisions you\'ll make at 65, and what happens if you miss your window.',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.quick-answer'],
    },
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
  dataset({
    name: 'Medicare Initial Enrollment Period',
    description: 'Official CMS guidance on the 7-month Initial Enrollment Period surrounding a person\'s 65th birthday.',
    creatorUrl: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start',
  }),
];
---
<BaseLayout
  title="Turning 65? Here's What You Need to Know About Medicare | Learn Medicare"
  description="Turning 65 soon? Learn your 7-month enrollment window, the 3 key decisions you'll make, and how to avoid late enrollment penalties. Free, no-pressure guidance."
  path="/turning-65/"
  breadcrumbs={[{ name: 'Turning 65', url: '/turning-65/' }]}
  jsonLd={jsonLd}
>
  <BreadcrumbNav crumbs={[{ name: 'Turning 65', url: '/turning-65/' }]} />
  <PageHero
    label="Turning 65"
    heading="Your Medicare Journey Starts at 65"
    subtext="Turning 65 brings a lot of mail, a lot of opinions, and a lot of unfamiliar terms. Here's the plain-English version of what actually matters and when."
  >
    <AuthorByline date={DATE_MODIFIED} datePublished={DATE_PUBLISHED} />
  </PageHero>

  <section>
    <div class="container">
      <div class="quick-answer">
        <p class="quick-answer-label">Quick Answer</p>
        <p>
          You have a 7-month window around your 65th birthday to enroll in Medicare without
          a penalty. During that window you'll decide on Part A, Part B, and whether to add a
          Medicare Advantage plan, a Medigap policy, and/or a Part D drug plan.
        </p>
      </div>

      <h2>Your 7-Month Window to Enroll</h2>
      <p>
        This window is called your <strong>Initial Enrollment Period (IEP)</strong>. It starts 3
        months before the month you turn 65, includes your birthday month, and runs 3 months
        after — 7 months total. Enrolling in the 3 months before your birthday month usually
        means your coverage starts the first day of your birthday month. Wait until later in the
        window, and your start date gets pushed back.
      </p>

      <div class="ts-timeline" role="img" aria-label="Timeline showing the 7-month Initial Enrollment Period: 3 months before your birthday month, your birthday month, and 3 months after.">
        <svg viewBox="0 0 700 160" xmlns="http://www.w3.org/2000/svg" width="100%" height="auto">
          <line x1="40" y1="90" x2="660" y2="90" stroke="var(--border)" stroke-width="4" />
          <rect x="40" y="82" width="180" height="16" rx="8" fill="var(--fill-purple-light)" />
          <rect x="220" y="82" width="100" height="16" rx="8" fill="var(--fill-accent)" />
          <rect x="320" y="82" width="180" height="16" rx="8" fill="var(--fill-purple-light)" />

          <circle cx="270" cy="90" r="12" fill="var(--fill-teal)" stroke="var(--bg-primary)" stroke-width="3" />

          <text x="130" y="60" text-anchor="middle" class="ts-label">3 months before</text>
          <text x="270" y="60" text-anchor="middle" class="ts-label ts-label-strong">Birthday month</text>
          <text x="410" y="60" text-anchor="middle" class="ts-label">3 months after</text>

          <text x="130" y="130" text-anchor="middle" class="ts-sub">Best time to enroll for on-time coverage</text>
          <text x="270" y="130" text-anchor="middle" class="ts-sub">Turning 65</text>
          <text x="410" y="130" text-anchor="middle" class="ts-sub">Coverage start delayed if you wait</text>
        </svg>
      </div>

      <h2 style="margin-top:2.5rem;">3 Decisions You'll Make at 65</h2>
      <div class="grid grid-3" style="margin-top: 1.5rem;">
        <div class="card">
          <h3>1. Part A</h3>
          <p>Hospital insurance. Most people qualify for it premium-free based on work history, and most people enroll as soon as they're eligible.</p>
        </div>
        <div class="card">
          <h3>2. Part B</h3>
          <p>Medical insurance for doctor visits and outpatient care. Carries a monthly premium — if you're still working with employer coverage, you may be able to delay it.</p>
        </div>
        <div class="card">
          <h3>3. What Comes Next</h3>
          <p>Once you have Parts A and B, you choose how to fill the gaps: a Medicare Advantage plan, a Medigap policy plus Part D, or Original Medicare alone.</p>
        </div>
      </div>
      <p style="margin-top:1.25rem;">
        Want the full breakdown of how Advantage and Medigap compare? See
        <a href="/coverage">Medicare Advantage vs. Medigap</a>, or start from the beginning with
        <a href="/basics">the basics of Parts A, B, C, and D</a>.
      </p>

      <h2 style="margin-top:2.5rem;">What Happens If You Miss Your Window</h2>
      <p>
        If you don't have other qualifying coverage (like an active employer plan) and you miss
        your Initial Enrollment Period, two things can happen. First, you may have to wait for the
        next enrollment period to sign up, leaving a gap with no coverage. Second, you may owe a
        <strong>late enrollment penalty</strong> — for Part B, that's typically an extra 10% of the
        standard premium for each full 12-month period you were eligible but didn't enroll, and it
        generally lasts as long as you have Medicare. A Part D late enrollment penalty works
        similarly for drug coverage. See <a href="/penalties">how late enrollment penalties work</a>
        for the full picture.
      </p>

      <div class="callout" style="margin-top: 2.5rem;">
        <p style="margin:0;">
          This page is educational only and not a recommendation of any specific plan. Your
          situation — especially if you're still working — can change your timeline. You can
          review official enrollment rules anytime at
          <a href="https://www.medicare.gov" target="_blank" rel="noopener noreferrer">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} />

  <section class="section-alt cta-band">
    <div class="container cta-inner">
      <h2>Your Next Step</h2>
      <p>Get a free, no-pressure Medicare review with Kayla Price, a licensed insurance agent (NPN 18530055), to walk through your options before your window closes.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Schedule Your Free Medicare Review</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-band { text-align: center; }
  .cta-inner p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 560px; margin-left: auto; margin-right: auto; }

  .quick-answer {
    border-left: 4px solid var(--fill-accent);
    background: var(--fill-purple-light);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  :root[data-theme="dark"] .quick-answer { background: rgba(144, 89, 181, 0.1); }
  .quick-answer-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fill-accent);
  }
  .quick-answer p:last-child { margin: 0; }

  .ts-timeline { margin: 1.5rem 0 2rem; }
  .ts-label { font-family: var(--font-body); font-size: 13px; fill: var(--text-primary); font-weight: 600; }
  .ts-label-strong { fill: var(--fill-accent); }
  .ts-sub { font-family: var(--font-body); font-size: 11px; fill: var(--text-secondary); }
</style>
