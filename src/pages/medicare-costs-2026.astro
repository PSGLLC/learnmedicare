---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import AuthorByline from '../components/AuthorByline.astro';
import FAQSection from '../components/FAQSection.astro';
import { authorship, dataset } from '../lib/schema';

const DATE_PUBLISHED = '2026-07-29';
const DATE_MODIFIED = '2026-07-29';

const faqs = [
  { question: 'How much is the Medicare Part B premium in 2026?', answer: 'The standard Medicare Part B premium in 2026 is $202.90 per month. Higher-income beneficiaries pay more through IRMAA surcharges, based on income reported two years prior (2024 tax returns).' },
  { question: 'What is the Medicare Part A deductible in 2026?', answer: 'The 2026 Part A deductible is $1,676 per benefit period. This is what you pay before Part A coverage kicks in for an inpatient hospital stay — it\'s not an annual deductible, but a per-benefit-period one, so it can apply more than once a year.' },
  { question: 'Do I have to pay a premium for Medicare Part A?', answer: 'Most people don\'t. If you or a spouse paid Medicare taxes for at least 40 quarters (10 years), Part A is premium-free. If you have 30-39 quarters, the 2026 Part A premium is $285/month. With fewer than 30 quarters, it\'s $518/month.' },
  { question: 'What is IRMAA and how much could it cost me?', answer: 'IRMAA (Income-Related Monthly Adjustment Amount) is a surcharge added to Part B and Part D premiums for higher-income beneficiaries. It\'s based on your Modified Adjusted Gross Income (MAGI) from two years prior, and it\'s tiered — the more you earn, the more you pay, up to several times the standard premium at the highest tiers.' },
  { question: 'What is the Part D out-of-pocket cap in 2026?', answer: 'As of 2026, Part D has a $2,100 annual out-of-pocket cap on covered prescription drugs. Once you hit that cap, you pay nothing more for covered Part D drugs for the rest of the calendar year — a result of the Inflation Reduction Act\'s Medicare drug pricing reforms.' },
  { question: 'What is the Part B deductible in 2026?', answer: 'The 2026 Part B annual deductible is $283. After you meet it, Medicare generally pays 80% of Medicare-approved costs for covered services, and you\'re responsible for the remaining 20% coinsurance, unless you have a Medigap policy or Medicare Advantage plan that covers it.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Medicare Costs 2026: Premiums, Deductibles & IRMAA',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.quick-answer'],
    },
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
  dataset({
    name: 'Medicare Part A Premium & Deductible 2026',
    description: 'The 2026 Medicare Part A deductible ($1,676 per benefit period) and premium tiers for beneficiaries without enough work history ($285/month for 30-39 quarters, $518/month for fewer than 30 quarters), as published by CMS.',
    creatorUrl: 'https://www.medicare.gov/basics/costs/medicare-costs',
  }),
  dataset({
    name: 'Medicare Part B Premium & Deductible 2026',
    description: 'The standard Medicare Part B monthly premium ($202.90) and annual deductible ($283) for 2026, as published by CMS.',
    creatorUrl: 'https://www.medicare.gov/basics/costs/medicare-costs',
  }),
  dataset({
    name: 'Medicare Part D Annual Out-of-Pocket Cap 2026',
    description: 'The 2026 Medicare Part D annual out-of-pocket spending cap ($2,100) on covered prescription drugs, as published by CMS.',
    creatorUrl: 'https://www.medicare.gov/drug-coverage-part-d/costs-for-medicare-drug-coverage',
  }),
  dataset({
    name: 'Medicare IRMAA Income Thresholds 2026',
    description: 'Official CMS/SSA Income-Related Monthly Adjustment Amount (IRMAA) thresholds affecting Part B and Part D premiums for higher-income beneficiaries in 2026.',
    creatorUrl: 'https://www.medicare.gov/basics/costs/medicare-costs/higher-income',
  }),
];
---
<BaseLayout
  title="Medicare Costs 2026: Premiums, Deductibles & IRMAA"
  description="The actual 2026 Medicare numbers: Part A and B premiums, deductibles, IRMAA income tiers, and the Part D out-of-pocket cap — explained in plain English."
  path="/medicare-costs-2026/"
  breadcrumbs={[{ name: 'Medicare Costs 2026', url: '/medicare-costs-2026/' }]}
  jsonLd={jsonLd}
>
  <BreadcrumbNav crumbs={[{ name: 'Medicare Costs 2026', url: '/medicare-costs-2026/' }]} />
  <PageHero
    label="2026 Figures"
    heading="Medicare Costs 2026"
    subtext="The actual premiums, deductibles, and out-of-pocket caps for 2026 — no guessing, no outdated numbers."
  >
    <AuthorByline date={DATE_MODIFIED} datePublished={DATE_PUBLISHED} />
  </PageHero>

  <section>
    <div class="container">
      <div class="quick-answer">
        <p class="quick-answer-label">Quick Answer</p>
        <p>
          In 2026, the standard Medicare Part B premium is <strong>$202.90/month</strong> with a
          <strong>$283 annual deductible</strong>. Part A is premium-free for most people, with a
          <strong>$1,676 deductible</strong> per benefit period. Part D has a
          <strong>$2,100 annual out-of-pocket cap</strong> on covered drugs.
        </p>
      </div>

      <h2>Part A Costs 2026</h2>
      <div style="overflow-x: auto; margin-top: 1.5rem;">
        <table class="compare">
          <thead>
            <tr><th>Item</th><th>2026 Amount</th></tr>
          </thead>
          <tbody>
            <tr><td>Premium — 40+ quarters of work history</td><td>$0/month</td></tr>
            <tr><td>Premium — 30-39 quarters</td><td>$285/month</td></tr>
            <tr><td>Premium — fewer than 30 quarters</td><td>$518/month</td></tr>
            <tr><td>Deductible (per benefit period)</td><td>$1,676</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top: 1rem;">
        Most people qualify for premium-free Part A because they or a spouse paid Medicare taxes
        for at least 10 years (40 quarters) while working. The deductible applies per benefit
        period, not per year — so if you have two separate hospital stays that aren't part of the
        same benefit period, you could pay the deductible twice in one year.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>Part B Costs 2026</h2>
      <div style="overflow-x: auto; margin-top: 1.5rem;">
        <table class="compare">
          <thead>
            <tr><th>Item</th><th>2026 Amount</th></tr>
          </thead>
          <tbody>
            <tr><td>Standard monthly premium</td><td>$202.90</td></tr>
            <tr><td>Annual deductible</td><td>$283</td></tr>
            <tr><td>Coinsurance after deductible</td><td>20% of Medicare-approved amount</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top: 1rem;">
        Unlike Part A, almost everyone pays a monthly premium for Part B. After you meet the $283
        annual deductible, Medicare generally covers 80% of the Medicare-approved cost for covered
        services, leaving you responsible for the remaining 20% — unless a Medigap policy or
        Medicare Advantage plan covers that gap. See <a href="/coverage">how Medigap and Medicare
        Advantage compare</a> on handling this cost-sharing.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>IRMAA: Income-Related Monthly Adjustment Amount</h2>
      <p>
        If your income is above a certain threshold, you'll pay more than the standard Part B and
        Part D premiums — this surcharge is called IRMAA. It's based on your Modified Adjusted
        Gross Income (MAGI) from your tax return <strong>two years prior</strong>, so your 2026
        premium is based on your 2024 income.
      </p>
      <div class="callout" style="margin-top: 1.5rem;">
        <p style="margin:0;">
          <strong>Key point:</strong> IRMAA is tiered — the higher your income, the higher the
          surcharge, in steps. It applies to both Part B and Part D premiums simultaneously. If your
          income dropped since the year used for the calculation (e.g., due to retirement), you can
          request a reconsideration from the Social Security Administration using Form SSA-44.
        </p>
      </div>
      <p style="margin-top: 1.5rem;">
        Use our free <a href="/calculators">IRMAA calculator</a> to estimate whether the surcharge
        applies to your specific income.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>Part D Costs 2026</h2>
      <p>
        Part D premiums vary significantly by plan and are set by private insurance companies, so
        there's no single "standard" Part D premium the way there is for Part B. What is
        standardized in 2026 is the annual out-of-pocket cap:
      </p>
      <div class="callout" style="margin-top: 1.5rem;">
        <p style="margin:0;">
          <strong>$2,100 annual out-of-pocket cap</strong> — once your out-of-pocket spending on
          covered Part D drugs reaches this amount in 2026, you pay $0 for the rest of the calendar
          year for those covered drugs. This cap is a result of the Inflation Reduction Act's
          Medicare drug pricing reforms and represents one of the biggest recent changes to Medicare
          drug costs.
        </p>
      </div>
      <p style="margin-top: 1.5rem;">
        For more on how this cap works in practice — including the insulin cost cap and the Extra
        Help program — see our blog post
        <a href="/blog/part-d-2000-cap/">Medicare Part D's $2,100 Out-of-Pocket Cap: What It Means
        for You in 2026</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Medicare Advantage Costs</h2>
      <p>
        Medicare Advantage (Part C) premiums vary widely by plan and county — many plans advertise
        $0 monthly premiums, but that doesn't mean the plan is free. You'll still pay your Part B
        premium, plus any plan-specific copays, coinsurance, and deductibles when you use services.
        Medicare Advantage plans do have an annual out-of-pocket maximum, unlike Original Medicare —
        a meaningful protection Original Medicare alone doesn't offer.
      </p>
      <p>
        Comparing total annual cost — not just the monthly premium — between Medicare Advantage
        and Medigap is one of the most important (and most often skipped) steps in choosing
        coverage. A plan with a $0 premium but a $6,000 out-of-pocket maximum could easily cost
        more in a bad health year than a plan with a modest monthly premium and lower cost-sharing.
        See our <a href="/coverage">full coverage comparison guide</a> for how to run that
        comparison for your own situation, factoring in your actual doctors, prescriptions, and
        expected healthcare use.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>Why These Numbers Change Every Year</h2>
      <p>
        CMS updates Medicare's premiums, deductibles, and out-of-pocket caps annually, typically
        announcing the following year's figures in the fall. These adjustments are tied to factors
        like national health spending trends and, for Part D specifically, the ongoing phase-in of
        Inflation Reduction Act drug pricing reforms. That's exactly why a page like this one needs
        a year in the title — cost figures from even a year or two ago can be meaningfully out of
        date, and using stale numbers when planning your coverage can lead to real budgeting
        surprises.
      </p>
      <p>
        If you're comparing quotes or plan materials that cite different numbers than the ones
        here, check the publication date — and when in doubt, confirm current figures directly at
        <a href="https://www.medicare.gov/basics/costs/medicare-costs" target="_blank" rel="noopener noreferrer">Medicare.gov</a>
        or with a licensed insurance agent.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Ways to Lower Your Medicare Costs</h2>
      <p>
        If the standard premiums and deductibles above are a strain on your budget, several
        assistance programs exist specifically to help:
      </p>
      <div class="grid grid-2" style="margin-top: 1.5rem;">
        <div class="card">
          <h3>Medicare Savings Programs (MSPs)</h3>
          <p>
            State-administered programs that can help pay your Part B premium, and in some cases
            deductibles and coinsurance, if your income and assets fall under state-set limits.
            Eligibility varies by state, so check with your state Medicaid office.
          </p>
        </div>
        <div class="card">
          <h3>Extra Help (Part D Low-Income Subsidy)</h3>
          <p>
            A federal program that helps pay Part D premiums, deductibles, and copays for people
            with limited income and resources. You can apply directly through the Social Security
            Administration, separately from your Part D plan enrollment.
          </p>
        </div>
        <div class="card">
          <h3>Medigap</h3>
          <p>
            While Medigap policies carry their own premium, they can eliminate most of the
            unpredictable out-of-pocket coinsurance and copays under Original Medicare — trading a
            fixed monthly cost for protection against larger, unpredictable bills.
          </p>
        </div>
        <div class="card">
          <h3>Comparing plans every year</h3>
          <p>
            Medicare Advantage and Part D plan costs and formularies can change year to year even
            if you don't switch plans. Reviewing your options during Fall AEP 2026 (Oct 15 - Dec 7)
            is one of the simplest ways to catch a cost increase before it hits your budget.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} />

  <section class="section-alt cta-band">
    <div class="container cta-inner">
      <h2>Want help estimating your actual costs?</h2>
      <p>
        Kayla Price is a licensed insurance agent (NPN 18530055) who can walk through your specific
        numbers with you — no pressure, no obligation. Call <a href="tel:8666481578">(866) 648-1578</a>.
      </p>
      <a href="/calculators" class="btn btn-primary">Try the Free Calculators</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-band { text-align: center; }
  .cta-inner p { color: var(--text-secondary); margin-bottom: 1.5rem; }

  .quick-answer {
    border-left: 4px solid var(--fill-accent);
    background: var(--fill-purple-light);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  :root[data-theme="dark"] .quick-answer {
    background: rgba(144, 89, 181, 0.1);
  }
  .quick-answer-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fill-accent);
  }
  .quick-answer p:last-child { margin: 0; }
</style>
