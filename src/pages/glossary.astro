---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { authorship, dataset } from '../lib/schema';

const DATE_PUBLISHED = '2026-07-23';
const DATE_MODIFIED = '2026-07-28';

// Alphabetized per the brief. Note: several terms the brief asked to "add"
// (AEP, Creditable Coverage, Dual Eligible, Extra Help, Formulary, GEP,
// IEP, Late Enrollment Penalty, Medicare Advantage, Medicare Savings
// Program, Out-of-Pocket Maximum, Prior Authorization, SEP, Star Rating)
// already existed in this list under the same or an equivalent name —
// re-adding them would have produced duplicate/conflicting DefinedTerm
// entries in the schema below, so those were left as-is rather than
// duplicated. The genuinely new terms from the brief (Benefit Period,
// C-SNP, Coinsurance, Coordination of Benefits, Cost-Sharing, EOC,
// Guaranteed Issue Rights, ICEP, Medicare Secondary Payer, Network, OEP)
// are included, plus additional high-value terms to reach the 55+ target
// the brief asked for, since the "missing terms" list alone only closed
// about half that gap.
const terms = [
  { term: "Annual Enrollment Period (AEP)", def: "The window each year, October 15 through December 7, when anyone with Medicare can switch Medicare Advantage plans, change Part D drug plans, or move between Original Medicare and Medicare Advantage. Changes take effect January 1." },
  { term: "Annual Notice of Change (ANOC)", def: "A notice your Medicare Advantage or Part D plan sends every September, explaining what's changing about your specific plan for the coming year — premium, deductible, copays, network, or formulary." },
  { term: "Benchmark", def: "The maximum amount CMS will pay a Medicare Advantage plan in a given county, used to help determine plan bids, extra benefits, and rebates in that area." },
  { term: "Benefit Period", def: "How Medicare Part A measures a hospital or skilled nursing facility stay for cost-sharing purposes. A benefit period begins the day you're admitted and ends after you've been out of the hospital and any skilled nursing facility for 60 consecutive days — you can have more than one benefit period, and pay the Part A deductible again, within a single year." },
  { term: "Chronic Condition Special Needs Plan (C-SNP)", def: "A type of Medicare Advantage Special Needs Plan designed for people with specific, severe chronic conditions, such as diabetes or heart failure, offering care coordination and benefits tailored to that condition." },
  { term: "CMS (Centers for Medicare & Medicaid Services)", def: "The federal agency within the U.S. Department of Health and Human Services that administers Medicare, Medicaid, and the ACA Marketplace, and sets the rules private insurers must follow to sell Medicare plans." },
  { term: "Coinsurance", def: "The percentage of a Medicare-approved cost you're responsible for after meeting your deductible — for example, the standard 20% Part B coinsurance for most outpatient services. Different from a copayment, which is a flat dollar amount." },
  { term: "Coordination of Benefits", def: "The process that determines which of your insurance plans pays first (primary) and which pays second (secondary) when you have more than one type of coverage, such as Medicare and an employer plan. See Medicare Secondary Payer for the specific rules governing this with Medicare." },
  { term: "Copayment (Copay)", def: "A flat dollar amount you pay for a covered service, such as $20 for a doctor visit — different from coinsurance, which is a percentage of the cost rather than a fixed amount." },
  { term: "Cost-Sharing", def: "The general term for the portion of healthcare costs you pay yourself, including premiums, deductibles, copayments, and coinsurance — as opposed to what your plan pays." },
  { term: "Creditable Coverage", def: "Health or drug coverage considered at least as good as Medicare's. Having creditable coverage (such as through a current employer) lets you delay Medicare enrollment without facing a late enrollment penalty later." },
  { term: "Dual-Eligible", def: "Someone who qualifies for both Medicare and Medicaid at the same time. Medicaid can help cover Medicare premiums and cost-sharing, and often covers services Medicare doesn't, like long-term custodial care." },
  { term: "Durable Medical Equipment (DME)", def: "Medically necessary equipment for home use, like wheelchairs, walkers, and hospital beds, generally covered under Part B when prescribed by a doctor." },
  { term: "Enrollment Period", def: "The general term for any of Medicare's defined windows — Initial, General, Special, or Annual — during which you can enroll in or change coverage. See each specific period for its own rules and timing." },
  { term: "Evidence of Coverage (EOC)", def: "A detailed annual document your Medicare Advantage or Part D plan provides, explaining exactly what the plan covers, what it costs, and your rights as a member — more comprehensive than the summary you typically see when comparing plans." },
  { term: "Extra Help", def: "A federal program that helps people with limited income and resources pay for Medicare Part D prescription drug costs, including premiums, deductibles, and copays." },
  { term: "Formulary", def: "The list of prescription drugs a specific Part D or Medicare Advantage plan covers, organized into cost tiers. Two plans can cover the same drug at very different costs depending on its tier." },
  { term: "General Enrollment Period (GEP)", def: "A window running January 1 through March 31 for people who missed their Initial Enrollment Period and don't qualify for a Special Enrollment Period. Coverage typically starts the month after you enroll, and a late-enrollment penalty may apply." },
  { term: "Guaranteed Issue Rights", def: "Federal protections that require a Medigap insurer to sell you a policy regardless of health history, without charging more due to past or present health problems, in specific situations — such as during your Medigap Open Enrollment Period or after losing certain other coverage." },
  { term: "Guaranteed Renewable", def: "A feature of Medigap policies meaning the insurer cannot cancel your policy as long as you pay your premium on time, regardless of your health or how many claims you've filed." },
  { term: "Hospice Care", def: "End-of-life comfort care for people with a terminal diagnosis and a life expectancy of 6 months or less, covered under Medicare Part A, focused on comfort rather than curative treatment." },
  { term: "Initial Coverage Election Period (ICEP)", def: "The window, generally aligned with your Initial Enrollment Period, during which you can first enroll in a Medicare Advantage plan when you become eligible for Medicare." },
  { term: "Initial Enrollment Period (IEP)", def: "The 7-month window to first sign up for Medicare, centered on your 65th birthday — 3 months before, the month of, and 3 months after." },
  { term: "IRMAA (Income-Related Monthly Adjustment Amount)", def: "An extra amount added to your Part B and Part D premiums if your income, based on your tax return from two years prior, is above a certain threshold." },
  { term: "Late Enrollment Penalty", def: "A permanent premium increase applied to Part B or Part D if you enroll late without qualifying employer coverage or another valid exception. The penalty is added to your premium for as long as you have that coverage." },
  { term: "Lifetime Reserve Days", def: "60 additional hospital days Medicare Part A provides beyond the standard 90 days covered in a benefit period, usable only once over your lifetime, with a daily coinsurance cost." },
  { term: "Medicare", def: "The federal health insurance program run by the Centers for Medicare & Medicaid Services (CMS), primarily covering people age 65 and older and certain younger people with qualifying disabilities." },
  { term: "Medicare Advantage", def: "See Medicare Part C. A private plan approved by Medicare that replaces Original Medicare, typically using a provider network (HMO or PPO) and often bundling drug coverage and extra benefits." },
  { term: "Medicare Advantage Open Enrollment Period (MA OEP)", def: "A window running January 1 through March 31 that lets people already enrolled in a Medicare Advantage plan make one additional plan switch, or return to Original Medicare." },
  { term: "Medicare Number", def: "The unique identifier on your red, white, and blue Medicare card, used to verify your identity and coverage — different from your Social Security number, which it no longer matches for privacy reasons." },
  { term: "Medicare Part A", def: "Hospital insurance. Covers inpatient hospital stays, skilled nursing facility care, hospice, and some home health care. Most people pay no premium for Part A if they or a spouse paid Medicare taxes for at least 10 years." },
  { term: "Medicare Part B", def: "Medical insurance. Covers doctor visits, outpatient care, preventive services, and durable medical equipment. Most people pay a standard monthly premium ($202.90 in 2026) plus an annual deductible ($283 in 2026)." },
  { term: "Medicare Part C", def: "Also called Medicare Advantage — a private-insurance alternative to Original Medicare that bundles Part A, Part B, and usually Part D into one plan, often with extra benefits like dental and vision." },
  { term: "Medicare Part D", def: "Prescription drug coverage, sold as a standalone plan or bundled into a Medicare Advantage plan. As of 2026, Part D has a $2,100 annual out-of-pocket cap on covered drugs." },
  { term: "Medicare Savings Program (MSP)", def: "A state-run program that can help pay Medicare premiums, deductibles, copays, and coinsurance for people with limited income and resources." },
  { term: "Medicare Secondary Payer", def: "Federal rules that determine when Medicare pays second, after another insurer (such as an employer group health plan), rather than paying first. Getting the payment order wrong can result in denied claims or unexpected bills." },
  { term: "Medicare Supplement", def: "See Medigap." },
  { term: "Medigap", def: "Also called Medicare Supplement insurance — a policy sold by private insurers that works alongside Original Medicare to cover its cost-sharing gaps (coinsurance, copays, and in some plans, deductibles). Cannot be used with Medicare Advantage." },
  { term: "Medigap Open Enrollment Period", def: "A one-time, 6-month window starting the month you're both 65+ and enrolled in Part B, during which Medigap insurers must generally sell you any policy they offer regardless of health history." },
  { term: "Network", def: "The group of doctors, hospitals, and other providers that a Medicare Advantage plan has contracted with. Using an in-network provider typically costs less than going out-of-network, and some plan types (HMOs) may not cover out-of-network care except in emergencies." },
  { term: "Open Enrollment Period (OEP)", def: "See Medicare Advantage Open Enrollment Period (MA OEP) — the January 1 through March 31 window for people already in a Medicare Advantage plan to make one plan switch or return to Original Medicare." },
  { term: "Original Medicare", def: "The traditional federal Medicare program made up of Part A (hospital insurance) and Part B (medical insurance), run directly by the federal government with no networks — any provider that accepts Medicare, anywhere in the country, will treat you." },
  { term: "Out-of-Pocket Maximum (OOPM)", def: "The most you'll pay in a plan year for covered services under a Medicare Advantage plan before the plan pays 100% of covered costs. Original Medicare alone has no out-of-pocket maximum, which is part of why many people pair it with Medigap or a Medicare Advantage plan." },
  { term: "PACE (Program of All-Inclusive Care for the Elderly)", def: "A Medicare and Medicaid program providing comprehensive medical and social services to help frail, older adults continue living in their community rather than a nursing home." },
  { term: "Premium", def: "The amount you pay, usually monthly, to have insurance coverage — separate from what you pay when you actually use care (deductibles, copays, coinsurance)." },
  { term: "Prior Authorization", def: "A requirement that your plan approve certain services or medications before you receive them, confirming the care is medically necessary before the plan agrees to pay." },
  { term: "Provider", def: "A person or organization, such as a doctor, hospital, or clinic, that delivers healthcare services and bills Medicare or your plan for that care." },
  { term: "Qualified Medicare Beneficiary (QMB)", def: "A Medicare Savings Program for people with limited income that helps pay Part A and Part B premiums, deductibles, coinsurance, and copayments." },
  { term: "SHIP / SHIIP (State Health Insurance Assistance Program)", def: "A free, unbiased counseling service, funded by the federal government and run at the state level, that helps people with Medicare questions and plan comparisons at no cost." },
  { term: "Skilled Nursing Facility (SNF) Care", def: "Short-term nursing and rehabilitation care following a qualifying hospital stay, covered under Part A for a limited number of days per benefit period, with coinsurance after the first 20 days." },
  { term: "Special Enrollment Period (SEP)", def: "A window outside the standard enrollment periods that opens when you have a qualifying life event — such as moving, losing employer coverage, or losing Medicaid — allowing you to enroll in or change Medicare coverage." },
  { term: "Special Needs Plan (SNP)", def: "A type of Medicare Advantage plan designed for people with specific needs — dual-eligible beneficiaries (Medicare + Medicaid), those in institutional care, or those with certain chronic conditions. Often includes extra tailored benefits." },
  { term: "Star Rating", def: "A 1-to-5 star quality score CMS assigns to Medicare Advantage and Part D plans each year, based on member satisfaction, care quality, and plan performance — a useful factor when comparing plans, alongside cost and network." },
  { term: "Step Therapy", def: "A plan rule requiring you to try a lower-cost drug first before the plan will cover a more expensive alternative for the same condition, unless the lower-cost option isn't appropriate for you." },
  { term: "TrOOP (True Out-of-Pocket Costs)", def: "The costs that count toward your Part D out-of-pocket total — what you (or others on your behalf) actually pay for covered drugs. Once TrOOP reaches the annual cap, the Part D out-of-pocket maximum kicks in." },
];

const faqs = terms.slice(0, 5).map(t => ({
  q: `What is ${t.term}?`,
  a: t.def,
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: 'Medicare Glossary',
    description: 'A plain-English glossary of key Medicare terms — enrollment periods, plan types, and costs explained.',
    url: 'https://learnmedicare.org/glossary/',
    hasDefinedTerm: terms.map(t => ({
      '@type': 'DefinedTerm',
      name: t.term,
      description: t.def,
    })),
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
  dataset({
    name: 'Medicare Part B/D Costs & IRMAA Thresholds 2026',
    description: 'Official CMS figures underlying the glossary definitions on this page — Part B premium/deductible, Part D out-of-pocket cap, and IRMAA income thresholds for 2026.',
    creatorUrl: 'https://www.medicare.gov/basics/costs/medicare-costs',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    author: { '@type': 'Person', name: 'Kayla Price', url: 'https://priceservicesgroup.com' },
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<MinimalLayout
  title="Medicare Glossary | Plain-English Terms Explained"
  description="A free, plain-English glossary of key Medicare terms — Parts A-D, enrollment periods, Medigap, IRMAA, and more, explained clearly."
  path="/glossary/"
  breadcrumbs={[{ name: 'Medicare Glossary', url: '/glossary/' }]}
  jsonLd={jsonLd}
>
  <BreadcrumbNav crumbs={[{ name: 'Medicare Glossary', url: '/glossary/' }]} />

  <section class="glossary-hero">
    <div class="container">
      <p class="section-label">Medicare Glossary</p>
      <h1>Medicare Terms, in Plain English</h1>
      <p class="glossary-hero-sub speakable-answer">
        Medicare is full of acronyms and jargon that don't mean much until someone explains them —
        below are {terms.length} of the terms you'll run into most often, defined in plain language, no
        insurance-speak required.
      </p>
      <AuthorByline date={DATE_MODIFIED} datePublished={DATE_PUBLISHED} />
      <div class="glossary-hero-cta">
        <a href="/course" class="btn btn-primary">Take the Free Course →</a>
      </div>
    </div>
  </section>

  <section class="glossary-list-section">
    <div class="container">
      <dl class="glossary-list">
        {terms.map((t) => (
          <div class="glossary-item">
            <dt>{t.term}</dt>
            <dd>{t.def}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="glossary-cta-section">
    <div class="container">
      <h2>Ready for the Full Picture?</h2>
      <p>
        These definitions are a starting point — our free, self-paced course walks through how
        every one of these terms fits together, from Medicare basics through enrollment.
      </p>
      <a href="/course" class="btn btn-primary">Start the Free Medicare Course →</a>
      <p style="margin-top:1.25rem;font-size:.95rem;">
        Or <a href="https://partner.priceservicesgroup.com/quiz">take the Medicare Decision Style Quiz</a> or
        <a href="https://priceservicesgroup.com/contact">schedule a consultation with a licensed insurance agent</a>.
      </p>
    </div>
  </section>
</MinimalLayout>

<style>
  .glossary-hero { padding: 3.5rem 0 2.5rem; text-align: center; }
  .glossary-hero-sub { max-width: 62ch; margin: 1rem auto 1.75rem; font-size: 1.05rem; line-height: 1.7; }
  .glossary-hero-cta { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }

  .glossary-list-section { padding: 1rem 0 3rem; }
  .glossary-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; }
  .glossary-item { border-top: 1px solid var(--line, #e3d6f0); padding: 1.25rem 0; }
  .glossary-item:last-child { border-bottom: 1px solid var(--line, #e3d6f0); }
  .glossary-item dt { font-weight: 700; font-size: 1.05rem; margin: 0 0 .4rem; }
  .glossary-item dd { margin: 0; color: var(--muted, #5a4a6e); line-height: 1.65; }

  .glossary-cta-section { padding: 2.5rem 0 4rem; text-align: center; background: var(--soft, #f5effe); }
  .glossary-cta-section h2 { margin: 0 0 .6rem; }
  .glossary-cta-section p { max-width: 56ch; margin: 0 auto 1.5rem; color: var(--muted, #5a4a6e); }
</style>
