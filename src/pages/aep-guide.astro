---
import BaseLayout from '../layouts/BaseLayout.astro';
import { authorship, dataset } from '../lib/schema';
import { BOOKING_URL } from '../site.config';

const DATE_PUBLISHED = '2026-07-28';
const DATE_MODIFIED = '2026-07-28';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Medicare Annual Enrollment Period 2026',
    description: 'AEP 2026 runs October 15 through December 7. Learn what you can change for Plan Year 2027 and how a free plan review works.',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.quick-answer'],
    },
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
  dataset({
    name: 'Medicare Annual Enrollment Period',
    description: 'Official CMS guidance on the Annual Enrollment Period (AEP), which runs October 15 through December 7 each year.',
    creatorUrl: 'https://www.medicare.gov/basics/get-started-with-medicare/medicare-basics/when-do-i-sign-up',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    author: { '@type': 'Person', name: 'Kayla Price', url: 'https://priceservicesgroup.com' },
    mainEntity: [
      {
        '@type': 'Question',
        name: 'When is AEP 2026?',
        acceptedAnswer: { '@type': 'Answer', text: 'AEP 2026 runs October 15 through December 7, 2026. Changes you make take effect January 1, 2027, for Plan Year 2027.' },
      },
      {
        '@type': 'Question',
        name: 'What can I change during AEP?',
        acceptedAnswer: { '@type': 'Answer', text: 'During AEP you can switch from one Medicare Advantage plan to another, switch from one Part D drug plan to another, join a Medicare Advantage or Part D plan for the first time, or drop Medicare Advantage and return to Original Medicare.' },
      },
      {
        '@type': 'Question',
        name: 'Do I have to do anything during AEP if I like my current plan?',
        acceptedAnswer: { '@type': 'Answer', text: 'You\'re not required to make a change, but it\'s worth a review every year — premiums, formularies, provider networks, and your own health needs can all shift from one plan year to the next, sometimes without much notice.' },
      },
      {
        '@type': 'Question',
        name: 'Is a Medicare plan review during AEP free?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. A plan review with a licensed insurance agent is free and comes with no obligation to enroll in anything.' },
      },
    ],
  },
];
---
<BaseLayout
  title="Medicare Annual Enrollment Period 2026 | Plan Year 2027 Guide | Learn Medicare"
  description="AEP 2026 runs October 15 – December 7. Learn what you can change for Plan Year 2027, why an annual review matters, and how a free plan review works."
  path="/aep-guide/"
  breadcrumbs={[{ name: 'AEP Guide', url: '/aep-guide/' }]}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Annual Enrollment</p>
      <h1>AEP 2026 Runs October 15 – December 7</h1>
      <p class="subhead">The Medicare Annual Enrollment Period is your yearly chance to change your coverage for Plan Year 2027. Here's what's on the table and how to make the most of it.</p>
      <p class="byline">Written by Kayla Price, Licensed Medicare Agent (NPN 18530055)</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="quick-answer">
        <p class="quick-answer-label">Quick Answer</p>
        <p>
          AEP 2026 runs from October 15 through December 7, 2026. During this window you can
          switch Medicare Advantage plans, switch Part D drug plans, or return to Original
          Medicare. Any change takes effect January 1, 2027, for Plan Year 2027.
        </p>
      </div>

      <h2>What You Can Change During AEP</h2>
      <ul>
        <li><strong>Switch Medicare Advantage plans</strong> — move from one MA plan to another to
          get better benefits, a different network, or a lower premium.</li>
        <li><strong>Switch Part D plans</strong> — move to a different standalone drug plan if your
          medications, pharmacy, or costs have changed.</li>
        <li><strong>Return to Original Medicare</strong> — drop a Medicare Advantage plan and go
          back to Original Medicare, optionally pairing it with a Medigap policy and a Part D plan.</li>
        <li><strong>Enroll for the first time</strong> — join a Medicare Advantage or Part D plan if
          you didn't have one before.</li>
      </ul>
      <p>
        Not sure how Advantage and Medigap compare? See
        <a href="/coverage">Medicare Advantage vs. Medigap</a> for a side-by-side breakdown.
      </p>

      <h2 style="margin-top:2.5rem;">5 Reasons to Review Your Plan Every Year</h2>
      <div class="grid grid-3" style="margin-top: 1.5rem;">
        <div class="card">
          <h3>Premiums Change</h3>
          <p>Plan premiums are set fresh each year and can go up, down, or disappear entirely as carriers adjust their offerings.</p>
        </div>
        <div class="card">
          <h3>Formularies Change</h3>
          <p>The drugs a Part D or MA plan covers, and at what cost, can shift from one plan year to the next.</p>
        </div>
        <div class="card">
          <h3>Networks Change</h3>
          <p>Doctors, hospitals, and pharmacies can move in or out of a plan's network without much warning.</p>
        </div>
        <div class="card">
          <h3>Your Health Changes</h3>
          <p>A new diagnosis, medication, or specialist can mean last year's "right" plan no longer fits.</p>
        </div>
        <div class="card">
          <h3>Better Options May Exist</h3>
          <p>New plans enter the market every year, sometimes with lower costs or better extra benefits than what you have now.</p>
        </div>
      </div>

      <h2 style="margin-top:2.5rem;">What to Have Ready Before Your Review</h2>
      <ul>
        <li>Your current plan's member ID card</li>
        <li>A list of your current medications, including dosages</li>
        <li>The names of the doctors and specialists you see</li>
      </ul>

      <h2 style="margin-top:2.5rem;">How a Free Plan Review Works</h2>
      <p>
        A free review with Kayla Price, a licensed insurance agent, takes a look at your current
        plan against what's available for Plan Year 2027 in your area — checking your medications,
        doctors, and pharmacy against each option. There's no cost and no obligation to enroll in
        anything; the goal is simply to make sure you understand your choices before AEP closes.
      </p>

      <div class="callout" style="margin-top: 2.5rem;">
        <p style="margin:0;">
          This page is educational only and not a recommendation of any specific plan. You can
          review official plan details anytime at
          <a href="https://www.medicare.gov" target="_blank" rel="noopener noreferrer">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details>
          <summary>When is AEP 2026?</summary>
          <p>AEP 2026 runs October 15 through December 7, 2026. Changes you make take effect January 1, 2027, for Plan Year 2027.</p>
        </details>
        <details>
          <summary>What can I change during AEP?</summary>
          <p>During AEP you can switch from one Medicare Advantage plan to another, switch from one Part D drug plan to another, join a Medicare Advantage or Part D plan for the first time, or drop Medicare Advantage and return to Original Medicare.</p>
        </details>
        <details>
          <summary>Do I have to do anything during AEP if I like my current plan?</summary>
          <p>You're not required to make a change, but it's worth a review every year — premiums, formularies, provider networks, and your own health needs can all shift from one plan year to the next, sometimes without much notice.</p>
        </details>
        <details>
          <summary>Is a Medicare plan review during AEP free?</summary>
          <p>Yes. A plan review with a licensed insurance agent is free and comes with no obligation to enroll in anything.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section-alt cta-band">
    <div class="container cta-inner">
      <h2>Review Your Plan Before AEP Closes</h2>
      <p>Get a free, no-obligation plan review with Kayla Price, a licensed insurance agent (NPN 18530055), before December 7.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Schedule Your Free Plan Review</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--color-lavender); padding: 4rem 0; }
  :root[data-theme="dark"] .page-hero { background: var(--color-bg-alt); }
  .subhead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 680px; }
  .cta-band { text-align: center; }
  .cta-inner p { color: var(--color-text-muted); margin-bottom: 1.5rem; max-width: 560px; margin-left: auto; margin-right: auto; }

  .quick-answer {
    border-left: 4px solid var(--color-purple);
    background: var(--color-lavender);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  :root[data-theme="dark"] .quick-answer { background: rgba(144, 89, 181, 0.1); }
  .quick-answer-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-purple);
  }
  .quick-answer p:last-child { margin: 0; }

  .byline { color: var(--color-text-muted); font-size: 0.9rem; font-style: italic; margin-top: 0.5rem; }

  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem; }
  .faq-list details {
    background: var(--color-bg-alt, #f8f5fb);
    border: 1px solid var(--color-lavender);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  :root[data-theme="dark"] .faq-list details { background: rgba(144, 89, 181, 0.08); }
  .faq-list summary { font-weight: 700; cursor: pointer; font-family: var(--font-heading); }
  .faq-list p { margin: 0.75rem 0 0; color: var(--color-text-muted); }
</style>
