---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import FAQSection from '../../components/FAQSection.astro';
import MarkCompleteButton from '../../components/MarkCompleteButton.astro';
import LessonFooterNav from '../../components/LessonFooterNav.astro';
import { authorship, learningResource } from '../../lib/schema';
import { lessonByN } from '../../lib/lessons';

const lesson = lessonByN(6);
const DATE_PUBLISHED = '2026-07-29';
const DATE_MODIFIED = '2026-07-29';

const faqs = [
  { question: 'What is the Initial Enrollment Period (IEP)?', answer: 'A 7-month window centered on your 65th birthday month — 3 months before, your birthday month, and 3 months after. This is the primary window most people use to enroll in Medicare.' },
  { question: 'What is the General Enrollment Period (GEP)?', answer: 'January 1 - March 31 each year, for anyone who missed their Initial Enrollment Period and doesn\'t qualify for a Special Enrollment Period. Coverage typically starts the month after you sign up, and late enrollment penalties may apply.' },
  { question: 'What is a Special Enrollment Period (SEP)?', answer: 'A window triggered by specific life events — most commonly losing employer group health coverage, moving, or losing Medicaid eligibility. SEPs let you enroll penalty-free outside the usual windows if you qualify, typically within about 2 months of the triggering event.' },
  { question: 'What is the Annual Enrollment Period (AEP)?', answer: 'October 15 - December 7 each year (AEP 2026, for Plan Year 2027 coverage). This is when anyone already enrolled in Medicare can switch Medicare Advantage or Part D plans for the following year.' },
];

const jsonLd = [
  learningResource({
    name: lesson.title,
    description: lesson.description,
    url: `https://learnmedicare.org${lesson.path}/`,
    position: lesson.n,
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: lesson.title,
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
];
---
<BaseLayout
  title="Lesson 6: How and When to Enroll in Medicare in 2026"
  description="Lesson 6 of the free Medicare course: the Initial, General, Special, and Annual Enrollment Periods explained, and how to avoid late penalties."
  path="/course/lesson-6/"
  breadcrumbs={[{ name: 'Take the Course', url: '/course/' }, { name: 'Lesson 6: How and When to Enroll', url: '/course/lesson-6/' }]}
  jsonLd={jsonLd}
>
  <BreadcrumbNav crumbs={[{ name: 'Take the Course', url: '/course/' }, { name: 'Lesson 6', url: '/course/lesson-6/' }]} />
  <PageHero
    label="Lesson 6 of 6"
    heading="How and When to Enroll"
    subtext="The final piece of the puzzle — the specific windows that determine when you can enroll in or change Medicare coverage, and how to avoid permanent penalties."
  >
    <AuthorByline date={DATE_MODIFIED} datePublished={DATE_PUBLISHED} />
  </PageHero>

  <section>
    <div class="container">
      <div class="quick-answer">
        <p class="quick-answer-label">Quick Answer</p>
        <p>
          Most people enroll during their Initial Enrollment Period, a 7-month window around their
          65th birthday. Miss it, and you may need to wait for the General Enrollment Period
          (Jan 1 - Mar 31) unless a Special Enrollment Period applies. Once enrolled, the Annual
          Enrollment Period (Oct 15 - Dec 7) is your yearly chance to switch plans.
        </p>
      </div>

      <h2>Initial Enrollment Period (IEP)</h2>
      <p>
        Your IEP is a 7-month window: 3 months before your 65th birthday month, your birthday
        month itself, and 3 months after. When you enroll within this window affects when your
        coverage starts:
      </p>
      <ul class="checklist">
        <li>Enrolling in the 3 months before your birthday month: coverage starts the first day of your birthday month</li>
        <li>Enrolling during your birthday month or the 3 months after: coverage start is delayed, generally by one to three months depending on when you sign up</li>
      </ul>
      <p>
        If you're already receiving Social Security or Railroad Retirement Board benefits before
        turning 65, you're automatically enrolled in Parts A and B — no action needed. Otherwise,
        you need to actively sign up.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>General Enrollment Period (GEP)</h2>
      <p>
        If you miss your IEP and don't qualify for a Special Enrollment Period, the General
        Enrollment Period runs January 1 through March 31 every year. Coverage generally starts the
        month after you sign up. The catch: enrolling through the GEP after missing your IEP
        typically means facing the Part B late enrollment penalty — a permanent 10% premium
        increase for each full 12-month period you were eligible but didn't enroll.
      </p>

      <h2>Special Enrollment Period (SEP)</h2>
      <p>
        SEPs let you enroll outside the usual windows, triggered by specific circumstances —
        most commonly losing employer group health coverage (yours or a spouse's), but also moving
        out of your plan's service area, losing Medicaid eligibility, or your plan leaving the
        Medicare program. Most SEPs have a limited window, often around 2 months from the
        triggering event, so acting promptly matters. If you're still working past 65 and covered
        by an employer plan, see <a href="/working-at-65">how that affects your SEP eligibility</a>
        when that coverage eventually ends.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Annual Enrollment Period (AEP)</h2>
      <p>
        Once you're enrolled in Medicare, AEP is your yearly opportunity to make changes — switch
        Medicare Advantage plans, switch Part D plans, or move between Medicare Advantage and
        Original Medicare. AEP 2026 runs <strong>October 15 through December 7, 2026</strong>, for
        coverage effective January 1, 2027 (Plan Year 2027). Any changes made during AEP take
        effect January 1 of the following year.
      </p>
      <p>
        There's also a separate, more limited Medicare Advantage Open Enrollment Period (January 1
        - March 31) for people already enrolled in a Medicare Advantage plan who want to switch to
        a different Medicare Advantage plan or back to Original Medicare.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>Putting the Timeline Together</h2>
      <div style="overflow-x: auto; margin-top: 1rem;">
        <table class="compare">
          <thead><tr><th>Window</th><th>When</th><th>Who It's For</th></tr></thead>
          <tbody>
            <tr><td>Initial Enrollment Period</td><td>7 months around your 65th birthday</td><td>First-time enrollees</td></tr>
            <tr><td>General Enrollment Period</td><td>Jan 1 - Mar 31 annually</td><td>Those who missed IEP, no SEP</td></tr>
            <tr><td>Special Enrollment Period</td><td>Varies, often ~2 months from the event</td><td>Qualifying life events</td></tr>
            <tr><td>Annual Enrollment Period</td><td>Oct 15 - Dec 7 annually (AEP 2026)</td><td>Anyone already enrolled, switching plans</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top: 1.5rem;">
        You've now covered the full arc of this course — what Medicare is, how Parts A and B work,
        Medicare Advantage vs. Original Medicare, Part D drug coverage, Medigap, and enrollment
        timing. For the complete written version of enrollment rules and exact date calculators,
        see our full <a href="/enrollment">Enrollment guide</a>, or review the
        <a href="/medicare-mistakes">Top 7 Medicare Mistakes</a> to make sure none of them apply to
        your situation.
      </p>
    </div>
  </section>

  <FAQSection faqs={faqs} />

  <MarkCompleteButton slug={lesson.slug} />

  <section class="cta-band">
    <div class="container cta-inner">
      <h2>You've completed the course.</h2>
      <p>
        Ready for personalized guidance? Kayla Price is a licensed insurance agent (NPN 18530055)
        offering free, no-pressure consultations. Call <a href="tel:8666481578">(866) 648-1578</a>.
      </p>
      <a href="/course" class="btn btn-primary">Back to Course Hub</a>
    </div>
  </section>

  <LessonFooterNav n={lesson.n} />
</BaseLayout>

<style>
  .cta-band { text-align: center; padding: 2.5rem 0; background: var(--fill-purple-light); }
  :root[data-theme="dark"] .cta-band { background: rgba(144, 89, 181, 0.1); }
  .cta-inner p { color: var(--text-secondary); margin-bottom: 1.5rem; }

  .quick-answer {
    border-left: 4px solid var(--fill-accent);
    background: var(--fill-purple-light);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  :root[data-theme="dark"] .quick-answer {
    background: rgba(144, 89, 181, 0.1);
  }
  .quick-answer-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fill-accent);
  }
  .quick-answer p:last-child { margin: 0; }

  .checklist { list-style: none; padding: 0; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .checklist li { position: relative; padding-left: 1.75rem; }
  .checklist li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--fill-teal);
    font-weight: 700;
  }
</style>
