---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarkCompleteButton from '../components/MarkCompleteButton.astro';
import { authorship, dataset } from '../lib/schema';

const DATE_PUBLISHED = '2026-07-23';
const DATE_MODIFIED = '2026-07-28';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'When to Enroll in Medicare',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.quick-answer'],
    },
    ...authorship(DATE_PUBLISHED, DATE_MODIFIED),
  },
  dataset({
    name: 'Medicare Enrollment Periods (IEP, GEP, AEP)',
    description: 'Official Medicare enrollment period definitions and dates — Initial Enrollment Period, General Enrollment Period, and the October 15–December 7 Annual Enrollment Period.',
    creatorUrl: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start',
  }),
  {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  author: { '@type': 'Person', name: 'Kayla Price', url: 'https://priceservicesgroup.com' },
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the Initial Enrollment Period (IEP)?',
      acceptedAnswer: { '@type': 'Answer', text: 'The IEP is a 7-month window around your 65th birthday (the 3 months before, the month of, and the 3 months after) when you can first sign up for Medicare.' },
    },
    {
      '@type': 'Question',
      name: 'What is a Special Enrollment Period (SEP)?',
      acceptedAnswer: { '@type': 'Answer', text: 'A SEP lets you enroll or make changes outside normal windows because of a qualifying life event, such as losing employer coverage or moving.' },
    },
    {
      '@type': 'Question',
      name: 'What is the General Enrollment Period (GEP)?',
      acceptedAnswer: { '@type': 'Answer', text: 'The GEP runs January 1 through March 31 each year for people who missed their Initial Enrollment Period and don\'t qualify for a Special Enrollment Period.' },
    },
    {
      '@type': 'Question',
      name: 'What is the Annual Enrollment Period (AEP)?',
      acceptedAnswer: { '@type': 'Answer', text: 'AEP runs October 15 through December 7 each year. It\'s when anyone already on Medicare can change Medicare Advantage or Part D plans for the following year.' },
    },
    {
      '@type': 'Question',
      name: 'What happens if I miss my Initial Enrollment Period?',
      acceptedAnswer: { '@type': 'Answer', text: 'If you miss your IEP and don\'t qualify for a Special Enrollment Period, you\'ll generally need to wait for the General Enrollment Period (Jan 1 - Mar 31), and you may face late enrollment penalties for Part B and Part D.' },
    },
    {
      '@type': 'Question',
      name: 'How much is the Medicare Part B late enrollment penalty?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Part B penalty adds about 10% to your monthly premium for each full 12-month period you were eligible but didn\'t enroll and didn\'t have other qualifying coverage. This penalty is generally permanent and applies for as long as you have Part B.' },
    },
    {
      '@type': 'Question',
      name: 'How do I actually sign up for Medicare?',
      acceptedAnswer: { '@type': 'Answer', text: 'You can enroll online at SSA.gov, by calling Social Security or 1-800-MEDICARE, by visiting a local Social Security office, or by working with a licensed Medicare agent who can walk you through your options at no cost to you.' },
    },
    ],
  },
];
---
<BaseLayout
  title="Medicare Enrollment Periods: IEP, SEP, GEP, AEP | LM"
  description="Understand the Medicare enrollment periods — IEP, SEP, GEP, and AEP — what happens if you miss them, and how to enroll. Plain-English guide."
  path="/enrollment/"
  breadcrumbs={[{ name: 'Enrollment', url: '/enrollment/' }]}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Enrollment</p>
      <h1>When can you enroll in Medicare?</h1>
      <p class="subhead">Medicare has several enrollment windows. Knowing which one applies to you helps you avoid gaps in coverage and unnecessary penalties.</p>
      <p class="byline">Written by Kayla Price, Licensed Medicare Agent (NPN 18530055)</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="quick-answer">
        <p class="quick-answer-label">Quick Answer</p>
        <p>
          The Medicare Initial Enrollment Period (IEP) is a 7-month window that begins 3 months
          before your 65th birthday month, includes your birthday month, and ends 3 months after.
          Missing this window may result in permanent late enrollment penalties.
        </p>
      </div>

      <h2>Medicare Enrollment Periods Explained</h2>
      <div class="grid grid-2">
        <div class="card">
          <h3>IEP — Initial Enrollment Period</h3>
          <p>
            Your Initial Enrollment Period is a 7-month window centered on your 65th birthday: the
            3 months before your birthday month, your birthday month itself, and the 3 months after.
            This is typically the first chance most people have to enroll in Medicare — see
            <a href="/basics">the basics of Parts A, B, C, and D</a> if you're still getting oriented.
            If you enroll in the 3 months before your birthday month, coverage generally starts the
            first of your birthday month. Enrolling during your birthday month or in the 3 months
            after can delay when your coverage actually begins, so earlier is almost always better.
          </p>
        </div>
        <div class="card">
          <h3>SEP — Special Enrollment Period</h3>
          <p>
            A Special Enrollment Period is triggered by certain life events — most commonly, losing
            employer group coverage or moving to a new service area. SEPs let you enroll or change
            coverage outside the usual windows without waiting for the next general opportunity. If
            you're still working past 65, see <a href="/working-at-65">how employer coverage affects your timing</a>.
            Most SEPs tied to losing employer coverage give you an 8-month window to sign up for
            Part B, starting the month after the employment or coverage ends — whichever comes first.
          </p>
        </div>
        <div class="card">
          <h3>GEP — General Enrollment Period</h3>
          <p>
            If you missed your Initial Enrollment Period and don't qualify for a Special Enrollment
            Period, the General Enrollment Period (January 1 – March 31 each year) gives you another
            chance to sign up for Part A and/or Part B. Coverage under the GEP generally starts the
            first day of the month after you enroll, which can mean a gap of several months without
            coverage — one more reason the IEP and SEP windows matter so much.
          </p>
        </div>
        <div class="card">
          <h3>AEP — Annual Enrollment Period</h3>
          <p>
            The Annual Enrollment Period, AEP 2026, runs <strong>October 15 – December 7, 2026</strong>.
            If you're already on Medicare, this is your annual opportunity to switch Medicare
            Advantage or Part D prescription drug plans for Plan Year 2027 coverage. Any changes you
            make during AEP 2026 take effect January 1, 2027.
          </p>
        </div>
      </div>

      <h2 style="margin-top:3rem;">What Happens If You Miss Your Enrollment Window</h2>
      <p>
        Missing your enrollment window doesn't just mean waiting longer to sign up — for Part B and
        Part D, it can mean paying more for as long as you have that coverage. Understanding these
        penalties is one of the biggest reasons to plan your enrollment ahead of time rather than
        after the fact.
      </p>
      <div class="grid grid-2" style="margin-top:1.5rem;">
        <div class="card">
          <h3>Part B late enrollment penalty</h3>
          <p>
            If you don't sign up for Part B when you're first eligible and don't have other
            qualifying coverage (such as active employer coverage), your monthly Part B premium can
            go up about 10% for each full 12-month period you were eligible but didn't enroll. This
            penalty is generally permanent — it applies for as long as you're enrolled in Part B, not
            just for a year or two.
          </p>
        </div>
        <div class="card">
          <h3>Part D late enrollment penalty</h3>
          <p>
            If you go 63 or more days in a row without Medicare drug coverage or other creditable
            prescription drug coverage after your Initial Enrollment Period ends, you may owe a Part D
            late enrollment penalty. It's calculated as roughly 1% of the "national base beneficiary
            premium" for each full month you went without creditable coverage, added to your premium
            for as long as you have Part D coverage.
          </p>
        </div>
      </div>
      <div class="warning" style="margin-top: 2rem;">
        <p style="margin:0;">
          <strong>Late enrollment can cost you.</strong> Missing your Initial Enrollment Period and
          not having other qualifying coverage can lead to late enrollment penalties for Part B and
          Part D that may last for as long as you have that coverage.
          Visit <a href="/penalties">Penalties</a> to see how these penalties are calculated. You can
          also confirm your personal enrollment dates at <a href="https://www.medicare.gov" target="_blank" rel="noopener noreferrer">Medicare.gov</a>
          or sign up directly through the <a href="https://www.ssa.gov/medicare/" target="_blank" rel="noopener noreferrer">Social Security Administration</a>.
        </p>
      </div>

      <h2 style="margin-top:3rem;">How to Enroll</h2>
      <p>
        There are a few different ways to actually sign up for Medicare once you know which
        enrollment period applies to you:
      </p>
      <ul>
        <li>
          <strong>Online at SSA.gov</strong> — the Social Security Administration handles Medicare
          enrollment, and signing up online at
          <a href="https://www.ssa.gov/medicare/" target="_blank" rel="noopener noreferrer">ssa.gov/medicare</a>
          is usually the fastest option for most people.
        </li>
        <li>
          <strong>By phone</strong> — call Social Security directly, or call
          <strong>1-800-MEDICARE</strong> (1-800-633-4227) for general Medicare questions and guidance
          on your options.
        </li>
        <li>
          <strong>In person</strong> — you can visit a local Social Security office if you'd rather
          enroll or ask questions face to face.
        </li>
        <li>
          <strong>With a licensed Medicare agent</strong> — a licensed agent can walk you through
          your enrollment timeline, explain Medicare Advantage vs. Medigap, and help you compare
          plans, generally at no cost to you.
        </li>
      </ul>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details>
          <summary>What is the Initial Enrollment Period (IEP)?</summary>
          <p>The IEP is a 7-month window around your 65th birthday (the 3 months before, the month of, and
            the 3 months after) when you can first sign up for Medicare.</p>
        </details>
        <details>
          <summary>What is a Special Enrollment Period (SEP)?</summary>
          <p>A SEP lets you enroll or make changes outside normal windows because of a qualifying life event,
            such as losing employer coverage or moving.</p>
        </details>
        <details>
          <summary>What is the General Enrollment Period (GEP)?</summary>
          <p>The GEP runs January 1 through March 31 each year for people who missed their Initial Enrollment
            Period and don't qualify for a Special Enrollment Period.</p>
        </details>
        <details>
          <summary>What is the Annual Enrollment Period (AEP)?</summary>
          <p>AEP runs October 15 through December 7 each year. It's when anyone already on Medicare can change
            Medicare Advantage or Part D plans for the following year.</p>
        </details>
        <details>
          <summary>What happens if I miss my Initial Enrollment Period?</summary>
          <p>If you miss your IEP and don't qualify for a Special Enrollment Period, you'll generally need to
            wait for the General Enrollment Period (Jan 1 – Mar 31), and you may face late enrollment penalties
            for Part B and Part D.</p>
        </details>
        <details>
          <summary>How much is the Medicare Part B late enrollment penalty?</summary>
          <p>The Part B penalty adds about 10% to your monthly premium for each full 12-month period you were
            eligible but didn't enroll and didn't have other qualifying coverage. This penalty is generally
            permanent and applies for as long as you have Part B.</p>
        </details>
        <details>
          <summary>How do I actually sign up for Medicare?</summary>
          <p>You can enroll online at SSA.gov, by calling Social Security or 1-800-MEDICARE, by visiting a
            local Social Security office, or by working with a licensed Medicare agent who can walk you through
            your options at no cost to you.</p>
        </details>
      </div>
    </div>
  </section>

  <p style="text-align:center;color:var(--color-text-muted);font-size:.95rem;max-width:640px;margin:0 auto 2rem;">
    Not sure which enrollment window applies to you? <a href="https://partner.priceservicesgroup.com/quiz">Take the Medicare Decision Style Quiz</a> or
    <a href="https://priceservicesgroup.com/contact">schedule a consultation with a Medicare advisor</a>.
  </p>

  <MarkCompleteButton slug="enrollment" />

  <section class="section-alt cta-band">
    <div class="container cta-inner">
      <h2>Next: compare your coverage options</h2>
      <p>Once you know when to enroll, it's time to understand Medicare Advantage vs. Medigap.</p>
      <a href="/coverage" class="btn btn-primary">Continue to Coverage Options</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--color-lavender); padding: 4rem 0; }
  :root[data-theme="dark"] .page-hero { background: var(--color-bg-alt); }
  .subhead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 680px; }
  .cta-band { text-align: center; }
  .cta-inner p { color: var(--color-text-muted); margin-bottom: 1.5rem; }

  .quick-answer {
    border-left: 4px solid var(--color-purple);
    background: var(--color-lavender);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  :root[data-theme="dark"] .quick-answer {
    background: rgba(144, 89, 181, 0.1);
  }
  .quick-answer-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-purple);
  }
  .quick-answer p:last-child { margin: 0; }

  .byline { color: var(--color-text-muted); font-size: 0.9rem; font-style: italic; margin-top: 0.5rem; }

  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem; }
  .faq-list details {
    background: var(--color-bg-alt, #f8f5fb);
    border: 1px solid var(--color-lavender);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  :root[data-theme="dark"] .faq-list details { background: rgba(144, 89, 181, 0.08); }
  .faq-list summary { font-weight: 700; cursor: pointer; font-family: var(--font-heading); }
  .faq-list p { margin: 0.75rem 0 0; color: var(--color-text-muted); }
</style>
